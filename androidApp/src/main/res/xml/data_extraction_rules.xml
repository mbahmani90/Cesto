<?xml version="1.0" encoding="utf-8"?>
<!-- Receipts contain the NIF and shopping habits: nothing leaves the phone, neither to the cloud
     backup nor to a new device. Gmail is the source of truth, so a new install syncs again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
