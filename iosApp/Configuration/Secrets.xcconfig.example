// Copy to Secrets.xcconfig (gitignored) and fill in from Google Cloud console:
// Google Auth Platform > Clients > "Cesto iOS".
GOOGLE_IOS_CLIENT_ID = 1234567890-abcdefg.apps.googleusercontent.com
// The same value with its parts reversed (shown as "iOS URL scheme" in the console).
GOOGLE_IOS_REVERSED_CLIENT_ID = com.googleusercontent.apps.1234567890-abcdefg
